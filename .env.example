# ==============================================================
# PROPERTY X AI — Frontend Environment Configuration
# ==============================================================

# Backend API URL
# Local Development: http://localhost:5001
# Production on Render: https://property-x-backend.onrender.com (or your custom domain)
NEXT_PUBLIC_API_URL=https://property-x-backend.onrender.com

# Google Maps API Key (Used for interactive GPS map, autocomplete, and places)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
