{
  "name": "backend",
  "version": "1.0.0",
  "description": "Property X AI Backend Platform",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "build": "npx prisma generate && tsc",
    "start": "npx prisma db push --accept-data-loss && node dist/src/app.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push --accept-data-loss",
    "prisma:migrate": "npx prisma migrate deploy",
    "test": "npm run build && node --test dist/src/__tests__/*.test.js"
  },
  "keywords": [
    "real-estate",
    "property-ai",
    "decision-intelligence",
    "india"
  ],
  "author": "Property X Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
